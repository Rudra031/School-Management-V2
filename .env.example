# ==============================================================================
# HORIZON SCHOOL MANAGEMENT ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Security Settings
DEBUG=False
SECRET_KEY=change-me-to-a-super-secret-random-50-character-key-for-production!
ALLOWED_HOSTS=school.edu.in,www.school.edu.in,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://school.edu.in,https://www.school.edu.in

# SSL & HTTPS Hardening (Set to True once SSL / HTTPS certificate is active)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database Configuration (postgresql / mysql / sqlite3)
DB_ENGINE=postgresql
DB_NAME=horizon_school_db
DB_USER=horizon_admin
DB_PASSWORD=SecureDatabasePassword2026!
DB_HOST=db
DB_PORT=5432

# School Institutional Details
DEFAULT_SCHOOL_NAME="Horizon Premier Public School"
DEFAULT_SCHOOL_AFFILIATION="Affiliated to CBSE, New Delhi (Affiliation No. 2430089 | School Code: 15614)"
DEFAULT_SCHOOL_ADDRESS="Sector 14, Urban Estate, Rohini, New Delhi - 110085"
DEFAULT_SCHOOL_PHONE="+91 (011) 2748-9012 / +91 98765 43210"
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_CURRENCY_CODE=INR
DEFAULT_ATTENDANCE_THRESHOLD=75.0

